# NEXT_PUBLIC_* values are baked into the bundle at BUILD time, not read at
# runtime. On Vercel/Netlify, setting or changing this in the dashboard has no
# effect until you trigger a NEW deploy - the old value stays compiled in.
#
# Deployed builds must point at the public API URL, not localhost, and that
# domain must also be listed in EXTRA_ORIGINS on the backend or the browser
# will block every request as a CORS violation.

NEXT_PUBLIC_API_URL=http://localhost:8000
